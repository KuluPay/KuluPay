{
    "name":  "@kulupay/core",
    "version":  "0.0.7",
    "description":  "Core logic for KuluPay SDK",
    "author":  "YonaniCodes",
    "license":  "MIT",
    "keywords":  [
                     "payment",
                     "stripe",
                     "paypal",
                     "chapa",
                     "crypto",
                     "sdk",
                     "kulupay"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/KuluPay/KuluPay.git",
                       "directory":  "packages/core"
                   },
    "homepage":  "https://github.com/KuluPay/KuluPay#readme",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "dev-source":  "./src/index.ts",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js",
                              "default":  "./dist/index.mjs"
                          },
                    "./api":  {
                                  "dev-source":  "./src/api/index.ts",
                                  "types":  "./dist/api/index.d.ts",
                                  "import":  "./dist/api/index.mjs",
                                  "require":  "./dist/api/index.js",
                                  "default":  "./dist/api/index.mjs"
                              },
                    "./async_hooks":  {
                                          "dev-source":  "./src/async_hooks/index.ts",
                                          "types":  "./dist/async_hooks/index.d.ts",
                                          "import":  "./dist/async_hooks/index.mjs",
                                          "require":  "./dist/async_hooks/index.js",
                                          "default":  "./dist/async_hooks/index.mjs"
                                      },
                    "./context":  {
                                      "dev-source":  "./src/context/index.ts",
