                                                      "dev-source":  "./src/payment-providers/chapa.ts",
                                                      "types":  "./dist/payment-providers/chapa.d.ts",
                                                      "import":  "./dist/payment-providers/chapa.mjs",
                                                      "require":  "./dist/payment-providers/chapa.js",
                                                      "default":  "./dist/payment-providers/chapa.mjs"
