                                        "types":  "./dist/test-utils/test-instance.d.ts",
                                        "import":  "./dist/test-utils/test-instance.mjs",
                                        "require":  "./dist/test-utils/test-instance.js",
                                        "default":  "./dist/test-utils/test-instance.mjs"
                                    }
                },
    "typesVersions":  {
                          "*":  {
                                    "*":  [
                                              "./dist/index.d.ts"
                                          ],
                                    "api":  [
                                                "./dist/api/index.d.ts"
                                            ],
                                    "async_hooks":  [
                                                        "./dist/async_hooks/index.d.ts"
                                                    ],
                                    "context":  [
                                                    "./dist/context/index.d.ts"
                                                ],
                                    "db":  [
                                               "./dist/db/index.d.ts"
                                           ],
                                    "error":  [
                                                  "./dist/error/index.d.ts"
                                              ],
                                    "payment-providers":  [
                                                              "./dist/payment-providers/index.d.ts"
                                                          ],
                                    "payment-providers/stripe":  [
                                                                     "./dist/payment-providers/stripe.d.ts"
                                                                 ],
                                    "payment-providers/chapa":  [
                                                                    "./dist/payment-providers/chapa.d.ts"
                                                                ],
                                    "payment-providers/paypal":  [
                                                                     "./dist/payment-providers/paypal.d.ts"
                                                                 ],
                                    "payment-providers/onchain":  [
                                                                         "./dist/payment-providers/onchain/index.d.ts"
                                                                     ],
                                    "payment-providers/blockchain":  [
                                                                         "./dist/payment-providers/blockchain/index.d.ts"
                                                                     ],
                                    "utils":  [
                                                  "./dist/utils/index.d.ts"
                                              ],
                                    "test-utils":  [
                                                       "./dist/test-utils/test-instance.d.ts"
                                                   ]
                                }
                      },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "lint":  "biome lint src",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "prepublishOnly":  "tsup"
                },
    "dependencies":  {
                         "zod":  "^4.0.0",
                         "better-call":  "latest",
                         "@farming-labs/orm":  "latest",
                         "@farming-labs/orm-sql":  "latest",
                         "@better-fetch/fetch":  "latest"
                     },
    "peerDependencies":  {
                             "stripe":  "^20.0.0",
                             "@paypal/paypal-js":  "^7.0.0",
                             "viem":  "^2.0.0",
                             "tronweb":  "^6.0.0"
                         },
    "peerDependenciesMeta":  {
                                 "pg":  {
                                            "optional":  true
                                        },
                                 "@neondatabase/serverless":  {
                                                                  "optional":  true
                                                              },
                                 "stripe":  {
                                                "optional":  true
                                            },
                                 "@paypal/paypal-js":  {
                                                           "optional":  true
                                                       },
                                 "viem":  {
                                              "optional":  true
                                          },
                                 "tronweb":  {
                                                 "optional":  true
                                             }
                             },
    "devDependencies":  {
                            "tsup":  "^8.0.0",
                            "pg":  "^8.22.0",
                            "@types/pg":  "^8.20.0",
                            "@neondatabase/serverless":  "^1.1.0",
                            "@types/node":  "^20.0.0"
                        }
}
