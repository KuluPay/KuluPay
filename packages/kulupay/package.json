{
    "name":  "@kulupay/kulupay",
    "version":  "0.0.9",
    "description":  "Unified Payment SDK",
    "author":  "YonaniCodes",
    "license":  "MIT",
    "keywords":  [
                     "payment",
                     "stripe",
                     "paypal",
                     "chapa",
                     "crypto",
                     "sdk",
                     "kulupay"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/KuluPay/KuluPay.git",
                       "directory":  "packages/kulupay"
                   },
    "homepage":  "https://github.com/KuluPay/KuluPay#readme",
    "main":  "./dist/index.js",
    "module":  "./dist/index.mjs",
    "types":  "./dist/index.d.ts",
    "exports":  {
                    ".":  {
                              "dev-source":  "./src/index.ts",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.mjs",
                              "require":  "./dist/index.js",
                              "default":  "./dist/index.mjs"
                          },
                    "./api":  {
                                  "dev-source":  "./src/api/index.ts",
                                  "types":  "./dist/api/index.d.ts",
                                  "import":  "./dist/api/index.mjs",
                                  "require":  "./dist/api/index.js",
                                  "default":  "./dist/api/index.mjs"
                              },
                    "./client":  {
                                     "dev-source":  "./src/client/index.ts",
                                     "types":  "./dist/client/index.d.ts",
                                     "import":  "./dist/client/index.mjs",
                                     "require":  "./dist/client/index.js",
                                     "default":  "./dist/client/index.mjs"
                                 },
                    "./client/stripe":  {
                                            "dev-source":  "./src/client/stripe.ts",
                                            "types":  "./dist/client/stripe.d.ts",
                                            "import":  "./dist/client/stripe.mjs",
                                            "require":  "./dist/client/stripe.js",
                                            "default":  "./dist/client/stripe.mjs"
                                        },
                    "./client/providers":  {
                                               "dev-source":  "./src/client/providers/index.ts",
                                               "types":  "./dist/client/providers/index.d.ts",
                                               "import":  "./dist/client/providers/index.mjs",
                                               "require":  "./dist/client/providers/index.js",
                                               "default":  "./dist/client/providers/index.mjs"
                                           },
                    "./next-js":  {
                                      "dev-source":  "./src/integrations/next-js.ts",
                                      "types":  "./dist/integrations/next-js.d.ts",
                                      "import":  "./dist/integrations/next-js.mjs",
                                      "require":  "./dist/integrations/next-js.js",
                                      "default":  "./dist/integrations/next-js.mjs"
                                  },
                    "./providers":  {
                                        "dev-source":  "./src/payment-providers/index.ts",
                                        "types":  "./dist/payment-providers/index.d.ts",
                                        "import":  "./dist/payment-providers/index.mjs",
                                        "require":  "./dist/payment-providers/index.js",
                                        "default":  "./dist/payment-providers/index.mjs"
                                    },
                    "./providers/stripe":  {
                                               "dev-source":  "./src/payment-providers/stripe.ts",
                                               "types":  "./dist/payment-providers/stripe.d.ts",
                                               "import":  "./dist/payment-providers/stripe.mjs",
                                               "require":  "./dist/payment-providers/stripe.js",
                                               "default":  "./dist/payment-providers/stripe.mjs"
                                           },
                    "./providers/chapa":  {
                                              "dev-source":  "./src/payment-providers/chapa.ts",
                                              "types":  "./dist/payment-providers/chapa.d.ts",
                                              "import":  "./dist/payment-providers/chapa.mjs",
                                              "require":  "./dist/payment-providers/chapa.js",
                                              "default":  "./dist/payment-providers/chapa.mjs"
                                          },
                    "./providers/paypal":  {
                                               "dev-source":  "./src/payment-providers/paypal.ts",
                                               "types":  "./dist/payment-providers/paypal.d.ts",
                                               "import":  "./dist/payment-providers/paypal.mjs",
                                               "require":  "./dist/payment-providers/paypal.js",
                                               "default":  "./dist/payment-providers/paypal.mjs"
                                           },
                    "./providers/blockchain":  {
                                                   "dev-source":  "./src/payment-providers/blockchain.ts",
                                                   "types":  "./dist/payment-providers/blockchain.d.ts",
                                                   "import":  "./dist/payment-providers/blockchain.mjs",
                                                   "require":  "./dist/payment-providers/blockchain.js",
                                                   "default":  "./dist/payment-providers/blockchain.mjs"
                                               }
                },
    "typesVersions":  {
                          "*":  {
                                    "*":  [
                                              "./dist/index.d.ts"
                                          ],
                                    "api":  [
                                                "./dist/api/index.d.ts"
                                            ],
                                    "client":  [
                                                   "./dist/client/index.d.ts"
                                               ],
                                    "client/stripe":  [
                                                          "./dist/client/stripe.d.ts"
                                                      ],
                                    "client/providers":  [
                                                             "./dist/client/providers/index.d.ts"
                                                         ],
                                    "next-js":  [
                                                    "./dist/integrations/next-js.d.ts"
                                                ],
                                    "providers":  [
                                                      "./dist/payment-providers/index.d.ts"
                                                  ],
                                    "providers/stripe":  [
                                                             "./dist/payment-providers/stripe.d.ts"
                                                         ],
                                    "providers/chapa":  [
                                                            "./dist/payment-providers/chapa.d.ts"
                                                        ],
                                    "providers/paypal":  [
                                                             "./dist/payment-providers/paypal.d.ts"
                                                         ],
                                    "providers/blockchain":  [
                                                                 "./dist/payment-providers/blockchain.d.ts"
                                                             ]
                                }
                      },
    "files":  [
                  "dist",
                  "README.md",
                  "LICENSE"
              ],
    "publishConfig":  {
                          "access":  "public"
                      },
    "scripts":  {
                    "build":  "tsup",
                    "dev":  "tsup --watch",
                    "lint":  "biome lint src",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "prepublishOnly":  "tsup"
                },
    "dependencies":  {
                         "@kulupay/core":  "workspace:*",
                         "@stripe/stripe-js":  "^3.0.0",
                         "nanostores": "^0.11.0"
                     },
    "peerDependencies":  {
                             "react":  "^18.0.0 || ^19.0.0"
                         },
    "peerDependenciesMeta":  {
                                 "react":  {
                                               "optional":  true
                                           }
                             },
    "devDependencies":  {
                            "tsup":  "^8.0.0",
                            "@types/react":  "^18.0.0 || ^19.0.0"
                        }
}
